# Default: same-machine access, or a reverse proxy running on this machine.
# For a proxy on another machine/container, set an appropriate bind address
# (e.g. 0.0.0.0) and firewall PORT so only the proxy can reach it.
# This listener is HTTP, not HTTPS. Never forward it directly to the internet.
HOST=127.0.0.1
PORT=4000
MEMBERS_FILE=members.json
DATA_FILE=data/state.json
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# Optional per-alert channels; leave blank to use DISCORD_CHANNEL_ID.
DISCORD_DROPS_CHANNEL_ID=
DISCORD_KILLS_CHANNEL_ID=
DISCORD_QUESTS_CHANNEL_ID=
DISCORD_CHAT_CHANNEL_ID=
# Optional channel for !stats; blank uses DISCORD_CHANNEL_ID. !verify stays in DISCORD_CHANNEL_ID.
DISCORD_STATS_CHANNEL_ID=
